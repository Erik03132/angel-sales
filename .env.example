# VK OAuth Credentials
VK_LOGIN=your_vk_login@example.com
VK_PASS=your_vk_password
VK_CLIENT_ID=2274003
VK_CLIENT_SECRET=your_vk_client_secret_here
VK_SCOPE=photos,wall,groups,offline
VK_USER_TOKEN=your_vk_user_token_here

# Telegram
ANGELOCHKA_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_PROXY=http://proxy.example.com:8080

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API (for visual content)
PEXELS_API_KEY=your_pexels_api_key_here

# Other services
BITRIX_WEBHOOK=https://your-bitrix-domain.bitrix24.com/rest/1/your_webhook_id/
OPENROUTER_KEY=your_openrouter_key_here

# Mango Office
MANGO_API_KEY=your_mango_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# A2A Governance (production)
A2A_SECRET=generate_with_openssl_rand_hex_32
A2A_GOVERNANCE_ENFORCE=0  # Set to 1 for production
A2A_TRUSTED_SENDERS=autopilot,smoke,test
