  .category-btn {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(191, 219, 254);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .category-btn.active {
    background: linear-gradient(to right, rgb(34, 197, 94), rgb(16, 185, 129));
    color: white;
    border-color: rgba(34, 211, 238, 0.5);
  }
</style>
